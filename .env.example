# UplineAgent environment template. Names only; never commit values.

# Runtime / URLs
NODE_ENV=
PUBLIC_BASE_URL=
INTERNAL_BASE_URL=
UPLINE_DATA_DIR=

# Authentication and durable account store
AUTH_SECRET=
AGENTS_CONFIG_JSON=
OWNER_LOGIN_EMAIL=
OWNER_LOGIN_ENFORCED=
OWNER_RESET_TOKEN=
OWNER_RESET_EXPIRES_AT=
OWNER_SETUP_TOKEN=
OWNER_SETUP_EXPIRES_AT=
GITHUB_DATA_TOKEN=
GITHUB_DATA_REPO=
GITHUB_DATA_PATH=

# Operations
OPS_API_KEY=
MANAGER_AGENT_IDS=
AGENT_IDENTITY=
ABEL_FALLBACK_CELL=

# Error tracking
SENTRY_DSN=

# Dedicated durable CRM database (P0/P1 migration target)
DATABASE_URL=

# Hosted Google Sheets adapter (never a local gog CLI)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
UPLINE_SHEETS_SPREADSHEET_ID=
GOG_ACCOUNT=
AGENT_ACCESS_REQUESTS_SHEET_ID=
AGENT_ACCESS_REQUESTS_SHEET_RANGE=
AGENT_ACCESS_REQUESTS_WEBHOOK_URL=

# Twilio voice and messaging
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=
TWILIO_SMS_FROM=
TWILIO_MESSAGING_SERVICE_SID=
ALERT_TO=

# AI provider (P3)
AI_PROVIDER_API_KEY=
AI_PROVIDER_BASE_URL=
AI_PROVIDER_MODEL=

# Optional providers
RESEND_API_KEY=
STRIPE_SECRET_KEY=
